; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="SVO GAME 22-26"
config/description="Стратегия с глобальной картой, вид сверху (Godot 4, Android). Версия 0.3 — глобальная карта Украины."
config/version="0.3.1"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/quit_on_go_back=false
config/icon="res://icon.svg"

[autoload]

DataLoader="*res://scripts/core/data_loader.gd"
GameState="*res://scripts/global_map/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
